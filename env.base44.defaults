# Base44 sandbox defaults for the contact form notification.
#
# These are NON-SECRET defaults so the backend can boot without credentials.
# Real secrets are delivered separately by the platform via /run/base44/app.env
# (wired as the LAST env_file entry in docker-compose.base44.yml, so its values
# always override anything here).
#
# Do NOT put real API keys in this file.

# Where contact-form notifications are delivered.
CONTACT_TO_EMAIL=info@heartenhome.org

# The verified Resend sending address (must be on a domain verified in Resend).
CONTACT_FROM_EMAIL=Hearten Website <notifications@heartenhome.org>

# Set via app secrets. Leave empty here — the placeholder is only so the app
# boots; email delivery stays disabled until a real key is provided.
RESEND_API_KEY=

# Shared token required by POST /api/contact/retry. Set via app secrets.
CONTACT_RETRY_TOKEN=
