# Base44 sandbox defaults for the contact-form notification (Google Workspace SMTP).
#
# These are NON-SECRET defaults so the API function can boot without credentials.
# Real secrets are delivered separately by the platform via /run/base44/app.env
# (wired as the LAST env_file entry in docker-compose.base44.yml, so its values
# always override anything here).
#
# Do NOT put real credentials in this file.

# Where contact-form notifications are delivered.
CONTACT_TO_EMAIL=info@heartenhome.org

# Authenticated sender. Must match the Google account the app password belongs to
# (or an alias configured on it). Defaults to SMTP_USERNAME when left blank.
CONTACT_FROM_EMAIL=ksykes@heartenhome.org

# Google Workspace SMTP endpoint (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP_USERNAME and SMTP_APP_PASSWORD come from app secrets — not set here.
